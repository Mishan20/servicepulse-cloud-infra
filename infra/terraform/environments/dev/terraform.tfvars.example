# Copy this file to terraform.tfvars (gitignored) and fill in your SSH public key:
#   cp terraform.tfvars.example terraform.tfvars

aws_region    = "ap-southeast-2"
instance_type = "t3.micro"

# Paste the output of: cat ~/.ssh/servicepulse_aws.pub
ssh_public_key = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIKtR6xg2PW6zGl3fxXgRVSVing0f1NkoLnLUAKGuYSKk servicepulse-aws"
